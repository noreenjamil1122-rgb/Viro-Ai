# =============================================================================
# ViroAI Environment Configuration
# =============================================================================

# Server Port (Default: 5000)
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your cluster connection string (e.g., mongodb+srv://<user>:<password>@cluster0.mongodb.net/viroai?retryWrites=true&w=majority)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/viroai?retryWrites=true&w=majority

# JWT Secret for User Authentication
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Dedicated Gemini API key for image generation
GEMINI_IMAGE_API_KEY=
